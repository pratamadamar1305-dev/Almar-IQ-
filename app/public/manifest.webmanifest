{
  "name": "DOJO TARUNG — Latihan Harian",
  "short_name": "Dojo Tarung",
  "description": "Latihan silat/tarung harian di rumah pakai sapu kayu + tas sekolah. Streak, timer, dan progres otomatis.",
  "lang": "id",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#080A10",
  "theme_color": "#080A10",
  "categories": ["health", "fitness", "sports", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mulai latihan hari ini",
      "short_name": "Latihan",
      "url": "./#/",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Timer Gong Tarung",
      "short_name": "Timer",
      "url": "./#/timer",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Lihat progres",
      "short_name": "Progres",
      "url": "./#/progres",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
